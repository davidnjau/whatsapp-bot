{% extends "layout.njk" %}
{% block title %}Orders — Dress Nation Admin{% endblock %}
{% block content %}
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:20px">
  <div>
    <p class="e-eyebrow" style="margin:0 0 8px">Shop</p>
    <h1 class="e-h1" style="margin:0">Orders</h1>
  </div>
  <a href="/admin/carts" class="e-btn">Active carts →</a>
</div>
{% if message %}<p style="background:var(--panel);border-radius:10px;padding:12px 14px;font-size:14px;margin-bottom:16px">{{ message }}</p>{% endif %}

<div style="display:flex;flex-direction:column;gap:14px">
  {% for o in orders %}
  <div class="e-card" style="display:flex;flex-direction:column;gap:12px;font-size:14px">
    <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px">
      <span style="font-weight:500">{{ o.dn }} · {{ o.customer_name }} · <span class="pricetag">Ksh {{ o.total_ksh }}</span></span>
      <span class="e-tag" style="
        {% if o.status in ['dropped', 'collected'] %}background:var(--accent);color:#fff
        {% elif o.status in ['paid', 'packed'] %}background:#f1e4cf;color:#6b4e1e
        {% elif o.status == 'cancelled' %}background:#f3dcd3;color:#7a1f2b
        {% else %}background:var(--panel);color:var(--muted){% endif %}">{{ o.status | replace('_', ' ') }}</span>
    </div>

    <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px">
      {% for i in o.items %}
      <li style="display:flex;align-items:center;gap:10px">
        <a href="/shop/img/{{ i.product_id }}" target="_blank" title="View photo" style="flex:none">
          <img src="/shop/img/{{ i.product_id }}" style="width:40px;height:52px;object-fit:cover;border-radius:6px;background:var(--panel)" alt="">
        </a>
        <span>
          {{ i.title or ('Dress #' + i.product_id) }}{% if i.size %} · size {{ i.size }}{% endif %} — Ksh {{ i.price_ksh }}
          {% if i.conflict_orders.length %}
          <span style="display:block;font-size:12px;color:#7a1f2b;font-weight:500">
            ⚠ Conflict: dress #{{ i.product_id }} also in
            {% for c in i.conflict_orders %}order #{{ c.id }} ({{ c.status }}){% if not loop.last %}, {% endif %}{% endfor %}
          </span>
          {% endif %}
        </span>
      </li>
      {% endfor %}
    </ul>

    <p class="e-muted" style="margin:0">
      📞 {{ o.phone }} · 📍 {{ o.town }} · 🚚 {{ o.delivery_option }} — {{ o.delivery_location }}
      {% if o.package_code %} · 📦 <span style="font-family:ui-monospace,monospace;color:var(--accent)">{{ o.package_code }}</span>{% endif %}
    </p>
    <p class="e-muted" style="margin:0;font-size:12px">{{ o.created_at }}{% if o.paid_at %} · paid {{ o.paid_at }}{% endif %}</p>

    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
      {% if o.status == 'paid' %}
      <form method="post" action="/admin/orders/{{ o.id }}/packed"><button class="e-btn">Mark packed</button></form>
      {% endif %}
      {% if o.status in ['paid', 'packed'] %}
      <form method="post" action="/admin/orders/{{ o.id }}/dropped" style="display:flex;gap:6px">
        <input name="packageCode" placeholder="Package code" class="e-input" style="width:140px" required>
        <button class="e-btn e-btn-dark">Dropped at Pickup Mtaani</button>
      </form>
      {% endif %}
      {% if o.status == 'dropped' %}
      <form method="post" action="/admin/orders/{{ o.id }}/collected"><button class="e-btn">Mark collected</button></form>
      {% endif %}
      {% if o.status in ['pending_payment', 'paid', 'packed'] %}
      <form method="post" action="/admin/orders/{{ o.id }}/cancel"
            onsubmit="return confirm('Cancel this order? Dresses go back on sale.')">
        <button class="e-btn" style="color:#7a1f2b;border-color:#d8b4ab">Cancel</button>
      </form>
      {% endif %}
    </div>
  </div>
  {% else %}
  <p class="e-muted e-card" style="font-size:14px">No orders yet.</p>
  {% endfor %}
</div>
{% endblock %}
