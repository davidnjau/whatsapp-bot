{% extends "layout.njk" %}
{% block title %}Coupons — Dress Nation Admin{% endblock %}
{% block content %}
<div style="margin-bottom:20px">
  <p class="e-eyebrow" style="margin:0 0 8px">Shop</p>
  <h1 class="e-h1" style="margin:0">Coupons</h1>
</div>

{% if message %}<p style="background:var(--panel);border-radius:10px;padding:12px 14px;font-size:14px;margin-bottom:16px">{{ message }}</p>{% endif %}

<form method="post" action="/admin/loyalty" class="e-card" style="display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;margin-bottom:20px">
  <div style="flex:1 1 200px">
    <h2 style="margin:0 0 6px;font-size:18px;font-weight:500">Loyalty reward</h2>
    <p class="e-muted" style="font-size:13px;margin:0">Customers earn a coupon automatically after every N paid orders.</p>
  </div>
  <label style="font-size:13px;color:var(--muted)">After every<input name="n" type="number" min="1" max="50" value="{{ loyaltyN }}" class="e-input" style="display:block;margin-top:4px;width:80px"> paid orders</label>
  <label style="font-size:13px;color:var(--muted)">Give<input name="percent" type="number" min="1" max="100" value="{{ loyaltyPercent }}" class="e-input" style="display:block;margin-top:4px;width:80px"> % off</label>
  <label style="font-size:13px;color:var(--muted)">Coupons expire after<input name="couponDays" type="number" min="1" max="365" value="{{ couponDays }}" class="e-input" style="display:block;margin-top:4px;width:80px"> days (default)</label>
  <button class="e-btn e-btn-dark">Save settings</button>
</form>

<form method="post" action="/admin/coupons" class="e-card" style="display:flex;flex-wrap:wrap;gap:12px;align-items:flex-end;margin-bottom:20px">
  <label style="font-size:13px;color:var(--muted)">Code<input name="code" required placeholder="CHRISTMAS" class="e-input" style="display:block;margin-top:4px;text-transform:uppercase"></label>
  <label style="font-size:13px;color:var(--muted)">% off<input name="percent" type="number" min="1" max="100" required placeholder="10" class="e-input" style="display:block;margin-top:4px;width:90px"></label>
  <label style="font-size:13px;color:var(--muted)">Expires (optional)<input name="expires" type="date" class="e-input" style="display:block;margin-top:4px"></label>
  <label style="font-size:13px;color:var(--muted)">Max uses (optional)<input name="maxUses" type="number" min="1" class="e-input" style="display:block;margin-top:4px;width:110px"></label>
  <button class="e-btn e-btn-dark">Save coupon</button>
</form>

{% if coupons.length %}
<div style="display:flex;flex-direction:column;gap:12px">
  {% for c in coupons %}
  <div class="e-card dn-row" style="display:flex;gap:14px;padding:14px;align-items:flex-start">
    <div style="flex:1 1 auto;min-width:0">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span style="font-weight:500;font-size:15px;letter-spacing:.02em">{{ c.code }}</span>
        <span class="e-tag" style="background:var(--panel);color:var(--ink)">{{ c.percent }}% off</span>
        <span class="e-tag" style="{% if c.active %}background:var(--accent);color:#fff{% else %}background:var(--panel);color:var(--muted){% endif %}">{{ 'active' if c.active else 'off' }}</span>
        {% if c.expires_at %}<span class="e-tag" style="background:#f3dcd3;color:#7a1f2b">ends {{ c.expires_at | date }}</span>{% endif %}
        <div style="margin-left:auto;display:flex;gap:8px;align-items:center">
          <form method="post" action="/admin/coupons/{{ c.id }}/toggle">
            <input type="hidden" name="active" value="{{ 'off' if c.active else 'on' }}">
            <button class="dn-icon {{ 'on' if c.active }}" title="{{ 'Active — click to turn off' if c.active else 'Off — click to activate' }}" aria-label="Toggle coupon">⏻</button>
          </form>
          <div class="dn-kebab">
            <button class="dn-icon" aria-haspopup="true" aria-label="More actions">⋯</button>
            <div class="dn-menu">
              <button type="button" onclick="navigator.clipboard&amp;&amp;navigator.clipboard.writeText('{{ c.code }}')">Copy code</button>
              <form method="post" action="/admin/coupons/{{ c.id }}/toggle">
                <input type="hidden" name="active" value="{{ 'off' if c.active else 'on' }}">
                <button>{{ 'Deactivate' if c.active else 'Activate' }}</button>
              </form>
            </div>
          </div>
        </div>
      </div>
      <p class="e-muted" style="font-size:13px;margin:8px 0 0">
        Used {{ c.used_count }}{% if c.max_uses %} / {{ c.max_uses }}{% endif %}
        {% if not c.expires_at %} · no expiry{% endif %}
      </p>
    </div>
  </div>
  {% endfor %}
</div>
{% else %}
<p class="e-muted e-card" style="font-size:14px">No coupons yet. Create one above — e.g. a Christmas code at 10% off.</p>
{% endif %}
{% endblock %}
