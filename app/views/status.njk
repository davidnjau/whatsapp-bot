{% extends "layout.njk" %}
{% block title %}Status — WhatsApp Bot{% endblock %}
{% block content %}
<div class="flex items-center justify-between">
  <h1 class="text-lg font-semibold">WhatsApp Status</h1>
  <div class="flex gap-3 text-sm">
    <a href="/admin/audiences" class="text-emerald-700 underline">Audiences</a>
    <a href="/admin/media" class="text-emerald-700 underline">Media library</a>
  </div>
</div>
{% if error %}<p class="text-sm text-red-700 bg-red-50 rounded-lg p-2">{{ error }}</p>{% endif %}
{% if queued %}<p class="text-sm text-emerald-800 bg-emerald-50 rounded-lg p-2">{{ queued }} ✓</p>{% endif %}

<form method="post" action="/admin/status" class="bg-white rounded-xl shadow p-4 space-y-3 text-sm">
  <label class="block">
    Type
    <select name="statusType" id="statusType" class="mt-1 w-full border rounded-lg px-3 py-2"
            onchange="document.querySelectorAll('[data-status-section]').forEach(e => e.style.display = (e.dataset.statusSection.split(',').includes(this.value)) ? '' : 'none'); document.getElementById('preview-box').style.display = this.value === 'text' ? '' : 'none';">
      <option value="text">text</option>
      <option value="image">image</option>
      <option value="video">video</option>
      <option value="voice">voice</option>
    </select>
  </label>

  <div data-status-section="text">
    <label class="block">
      Text
      <textarea name="text" rows="3" class="mt-1 w-full border rounded-lg p-2"
                oninput="document.getElementById('preview-text').textContent = this.value"></textarea>
    </label>
  </div>

  <div data-status-section="image,video,voice" style="display:none" class="space-y-3">
    <label class="block">
      Media library item
      <select name="mediaId" class="mt-1 w-full border rounded-lg px-3 py-2">
        <option value="">— none, use URL below —</option>
        {% for m in media %}
        <option value="{{ m.id }}">#{{ m.id }} {{ m.name }} ({{ m.mimetype }})</option>
        {% endfor %}
      </select>
    </label>
    <label class="block">
      …or file URL
      <input name="fileUrl" placeholder="https://…/promo.jpg" class="mt-1 w-full border rounded-lg px-3 py-2">
    </label>
    <label class="block" data-status-section="image">
      Caption
      <input name="caption" class="mt-1 w-full border rounded-lg px-3 py-2">
    </label>
  </div>

  <div class="grid grid-cols-2 gap-3">
    <label class="block">
      Background color
      <input name="backgroundColor" type="color" value="#38b48e" class="mt-1 w-full border rounded-lg h-10"
             oninput="document.getElementById('preview-box').style.backgroundColor = this.value">
    </label>
    <label class="block">
      Font (text statuses, 0–5)
      <input name="font" type="number" min="0" max="5" placeholder="0" class="mt-1 w-full border rounded-lg px-3 py-2">
    </label>
  </div>

  <div id="preview-box" class="rounded-xl p-6 text-center text-white text-lg font-medium min-h-[90px]"
       style="background-color:#38b48e">
    <span id="preview-text">Preview</span>
  </div>

  <label class="block">
    Audience
    <select name="audienceId" class="mt-1 w-full border rounded-lg px-3 py-2">
      <option value="">All contacts (default)</option>
      {% for a in audiences %}
      <option value="{{ a.id }}">{{ a.name }} ({{ a.member_count }} contacts)</option>
      {% endfor %}
    </select>
  </label>

  <fieldset class="space-y-2">
    <label class="flex items-center gap-2"><input type="radio" name="scheduleKind" value="now" checked> Post now</label>
    <label class="flex items-center gap-2">
      <input type="radio" name="scheduleKind" value="once"> Once at
      <input name="onceAt" type="datetime-local" class="border rounded-lg px-2 py-1">
    </label>
    <label class="flex items-center gap-2">
      <input type="radio" name="scheduleKind" value="daily"> Daily at
      <input name="dailyTime" type="time" class="border rounded-lg px-2 py-1">
    </label>
  </fieldset>

  <button class="bg-emerald-700 text-white rounded-lg px-4 py-2 font-medium">Post status</button>
</form>

{% if definitions.length %}
<div class="bg-white rounded-xl shadow p-4">
  <h2 class="font-semibold mb-2">Scheduled & recurring</h2>
  <ul class="divide-y text-sm">
    {% for d in definitions %}
    <li class="py-2 flex items-center justify-between gap-2">
      <span>
        <span class="font-mono">{{ d.status_type }}</span>
        {% if d.schedule_kind == 'daily' %} · daily (cron {{ d.cron }})
        {% else %} · once at {{ d.scheduled_at }}{% endif %}
      </span>
      <form method="post" action="/admin/status/definitions/{{ d.id }}/cancel">
        <button class="text-xs border rounded px-2 py-1 text-red-600 hover:bg-red-50">cancel</button>
      </form>
    </li>
    {% endfor %}
  </ul>
</div>
{% endif %}

<div class="bg-white rounded-xl shadow p-4">
  <h2 class="font-semibold mb-2">History</h2>
  <ul class="divide-y text-sm">
    {% for h in history %}
    <li class="py-2 flex items-center justify-between gap-2">
      <span>
        <span class="text-gray-500 text-xs">{{ h.created_at }}</span>
        · <span class="font-mono">{{ h.payload.input.type }}</span>
        {% if h.payload.input.text %} · {{ h.payload.input.text | truncate(40) }}{% endif %}
        · <span class="text-xs px-2 py-0.5 rounded-full
            {% if h.status == 'failed' %}bg-red-100 text-red-800{% else %}bg-emerald-100 text-emerald-800{% endif %}">
            {{ h.status }}</span>
        {% if h.error %}<span class="text-xs text-red-600">{{ h.error | truncate(60) }}</span>{% endif %}
      </span>
      {% if h.waha_message_id %}
      <form method="post" action="/admin/status/delete">
        <input type="hidden" name="sendId" value="{{ h.id }}">
        <button class="text-xs border rounded px-2 py-1 text-red-600 hover:bg-red-50">delete</button>
      </form>
      {% endif %}
    </li>
    {% else %}
    <li class="py-2 text-gray-500">No statuses posted yet.</li>
    {% endfor %}
  </ul>
</div>
{% endblock %}
