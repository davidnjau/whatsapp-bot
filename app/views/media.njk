{% extends "layout.njk" %}
{% block title %}Media — WhatsApp Bot{% endblock %}
{% block content %}
<a href="/admin/status" class="text-sm text-emerald-700 underline">← Status</a>
<h1 class="text-lg font-semibold">Media library</h1>
<p class="text-sm text-gray-500">Upload once, reuse in statuses.</p>
{% if message %}<p class="text-sm bg-emerald-50 text-emerald-800 rounded-lg p-2">{{ message }}</p>{% endif %}

<form method="post" action="/admin/media" enctype="multipart/form-data"
      class="bg-white rounded-xl shadow p-4 flex gap-2 items-center text-sm">
  <input type="file" name="file" class="flex-1" required>
  <button class="bg-emerald-700 text-white rounded-lg px-4 py-2 font-medium">Upload</button>
</form>

<div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
  {% for m in media %}
  <div class="bg-white rounded-xl shadow p-3 text-sm space-y-2">
    {% if m.mimetype and m.mimetype.startsWith('image/') %}
    <img src="/admin/media/{{ m.id }}/file" alt="{{ m.name }}" class="w-full h-28 object-cover rounded-lg">
    {% else %}
    <div class="w-full h-28 rounded-lg bg-gray-100 flex items-center justify-center text-3xl">📄</div>
    {% endif %}
    <p class="truncate font-mono text-xs">#{{ m.id }} {{ m.name }}</p>
    <form method="post" action="/admin/media/{{ m.id }}/delete" onsubmit="return confirm('Delete file?')">
      <button class="text-xs border rounded px-2 py-1 text-red-600 hover:bg-red-50">delete</button>
    </form>
  </div>
  {% else %}
  <p class="text-sm text-gray-500 col-span-full">Nothing uploaded yet.</p>
  {% endfor %}
</div>
{% endblock %}
