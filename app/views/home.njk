{% extends "layout.njk" %}
{% block title %}Overview — Dress Nation Admin{% endblock %}
{% block content %}
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:28px">
  <div>
    <p class="e-eyebrow" style="margin:0 0 8px">Admin</p>
    <h1 class="e-h1" style="margin:0">Overview</h1>
  </div>
  <span class="e-tag" style="border:1px solid var(--ink)
    {% if status == 'WORKING' %};background:var(--accent);color:#fff;border-color:var(--accent)
    {% elif status == 'SCAN_QR_CODE' %};background:#f1ebe4{% endif %}">
    WhatsApp: {{ status }}
  </span>
</div>

{% if status == 'SCAN_QR_CODE' %}
<div class="e-card" style="text-align:center;margin-bottom:24px">
  <img src="/admin/qr.png" alt="QR code" style="margin:0 auto;width:256px;max-width:100%;border:1px solid var(--line);border-radius:12px">
  <p class="e-muted" style="margin-top:12px;font-size:14px">
    WhatsApp → Settings → Linked devices → Link a device, then scan this code. Refresh if it expires.
  </p>
</div>
{% endif %}

<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:16px;margin-bottom:28px">
  {% for card in [
    { label: 'Messages in today', value: today.messagesIn },
    { label: 'Bot replies today', value: today.replies },
    { label: 'Notifications today', value: today.notifications },
    { label: 'Group posts today', value: today.groupPosts },
    { label: 'Statuses today', value: today.statuses },
    { label: 'In queue', value: queued }
  ] %}
  <div class="e-card">
    <div class="e-eyebrow">{{ card.label }}</div>
    <div style="font-size:34px;font-weight:500;letter-spacing:-.02em;margin-top:10px">{{ card.value }}</div>
  </div>
  {% endfor %}
</div>

<div class="e-card" style="margin-bottom:24px">
  <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px">
    <h2 style="margin:0;font-size:20px;font-weight:500">Session “{{ session }}”</h2>
    <form method="post" action="/admin/session/restart"><button class="e-btn">Restart session</button></form>
  </div>
</div>

<div class="e-card">
  <h2 style="margin:0 0 12px;font-size:20px;font-weight:500">Recent errors</h2>
  {% if webhookErrors.length or failedSends.length %}
  <ul style="list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:10px;font-size:14px">
    {% for e in webhookErrors %}
    <li style="border-left:3px solid #c0623f;padding-left:10px">
      <span class="e-muted">{{ e.received_at }}</span> — webhook
      <span style="font-family:ui-monospace,monospace">{{ e.event_type }}</span>: {{ e.error | truncate(120) }}
    </li>
    {% endfor %}
    {% for s in failedSends %}
    <li style="border-left:3px solid #b8903a;padding-left:10px">
      <span class="e-muted">{{ s.created_at }}</span> — send
      <span style="font-family:ui-monospace,monospace">{{ s.kind }}</span> to {{ s.chat_id }}: {{ (s.error or 'failed') | truncate(120) }}
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="e-muted" style="margin:0;font-size:14px">None 🎉</p>
  {% endif %}
</div>
{% endblock %}
