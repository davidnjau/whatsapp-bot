{# Shared admin sidebar nav — collapsible groups. Included by layout.njk and the
   editorial standalone pages. Styling comes from each page's own stylesheet
   (.nav-link / .nav-group / .nav-grp / .nav-chev); behaviour is self-contained
   in the script below (active page, open active group, remember collapsed). #}
<nav class="nav-root" aria-label="Admin">
  <a class="nav-link" href="/admin">Overview</a>

  <details class="nav-grp" data-key="shop" open>
    <summary class="nav-group">Shop <svg class="nav-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
    <a class="nav-link" href="/admin/catalogue">Dresses</a>
    <a class="nav-link" href="/admin/orders">Orders</a>
    <a class="nav-link" href="/admin/carts">Carts</a>
    <a class="nav-link" href="/admin/coupons">Coupons</a>
    <a class="nav-link" href="/shop" target="_blank" rel="noopener">View shop ↗</a>
  </details>

  <details class="nav-grp" data-key="marketing" open>
    <summary class="nav-group">Marketing <svg class="nav-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
    <a class="nav-link" href="/admin/campaigns">Campaigns</a>
    <a class="nav-link" href="/admin/notify">Notify</a>
    <a class="nav-link" href="/admin/templates">Templates</a>
  </details>

  <details class="nav-grp" data-key="bot" open>
    <summary class="nav-group">Bot <svg class="nav-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
    <a class="nav-link" href="/admin/chats">Chats</a>
    <a class="nav-link" href="/admin/contacts">Contacts</a>
    <a class="nav-link" href="/admin/groups">Groups</a>
  </details>

  <details class="nav-grp" data-key="ict" open>
    <summary class="nav-group">ICT support <svg class="nav-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></summary>
    <a class="nav-link" href="/admin/status">Status</a>
    <a class="nav-link" href="/admin/gpu">Spend &amp; health</a>
    <a class="nav-link" href="/admin/knowledge">Knowledge</a>
  </details>
</nav>
<script>
(function () {
  var root = document.currentScript.previousElementSibling;
  if (!root || !root.classList.contains('nav-root')) root = document.querySelector('.nav-root');
  if (!root) return;
  var links = [].slice.call(root.querySelectorAll('.nav-link'));
  var groups = [].slice.call(root.querySelectorAll('.nav-grp'));

  // Highlight the current page (longest matching /admin href) and note its group.
  var path = location.pathname.replace(/\/+$/, '') || '/';
  var best = null, bestLen = -1;
  links.forEach(function (a) {
    var href = (a.getAttribute('href') || '').replace(/\/+$/, '') || '/';
    if (href.indexOf('/admin') !== 0) return;
    if (href === '/admin') { if (path === '/admin' && bestLen < 0) { best = a; bestLen = 6; } return; }
    if (path === href || path.indexOf(href + '/') === 0) { if (href.length > bestLen) { best = a; bestLen = href.length; } }
  });
  var activeGrp = null;
  if (best) { best.setAttribute('aria-current', 'page'); activeGrp = best.closest('.nav-grp'); }

  // Restore collapsed groups from storage, but always open the active one.
  var saved = [];
  try { saved = JSON.parse(localStorage.getItem('navCollapsed')) || []; } catch (e) {}
  groups.forEach(function (d) {
    if (d === activeGrp) { d.open = true; return; }
    d.open = saved.indexOf(d.getAttribute('data-key')) < 0;
  });

  // Persist open/closed on toggle.
  groups.forEach(function (d) {
    d.addEventListener('toggle', function () {
      var set = [];
      try { set = JSON.parse(localStorage.getItem('navCollapsed')) || []; } catch (e) {}
      var key = d.getAttribute('data-key'), i = set.indexOf(key);
      if (d.open) { if (i >= 0) set.splice(i, 1); } else if (i < 0) set.push(key);
      try { localStorage.setItem('navCollapsed', JSON.stringify(set)); } catch (e) {}
    });
  });
})();
</script>
