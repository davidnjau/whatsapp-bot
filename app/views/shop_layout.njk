<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ brand.name }} {{ brand.suffix }}{% endblock %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#ffffff; --panel:#f1ebe4; --ink:#2b2724; --muted:#6b625b;
      --line:#e5ddd4; --accent:#5c6534; --cream:#faf9f5;
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);
      font-family:Inter,system-ui,-apple-system,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased}
    a{color:var(--ink);text-decoration:none}
    a:hover{color:var(--accent)}
    img{max-width:100%;display:block}
    h1,h2,h3{font-weight:500;letter-spacing:-.02em;margin:0}
    .wrap{max-width:1200px;margin:0 auto;padding:0 24px}
    .eyebrow{font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin:0}
    .announce{font-size:12px;letter-spacing:.14em;text-transform:uppercase;text-align:center;
      padding:12px 16px;border-bottom:1px solid var(--line);color:var(--muted)}
    header.site{max-width:1200px;margin:0 auto;padding:20px 24px;display:flex;flex-wrap:wrap;
      align-items:center;justify-content:space-between;gap:16px}
    .logo{font-size:24px;letter-spacing:.06em}
    .logo span{color:var(--accent)}
    nav.pills{display:flex;flex-wrap:wrap;gap:4px;align-items:center;font-size:13px;letter-spacing:.08em;
      text-transform:uppercase;border:1px solid var(--line);border-radius:999px;padding:6px}
    nav.pills a{padding:10px 16px;border-radius:999px}
    nav.pills a:hover{background:var(--panel)}
    nav.pills a.bag{background:var(--ink);color:#fff;display:inline-flex;align-items:center;gap:8px;padding:10px 18px}
    nav.pills a.bag:hover{background:var(--accent)}
    .btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;cursor:pointer;
      font:500 13px Inter,sans-serif;letter-spacing:.08em;text-transform:uppercase;
      border-radius:999px;border:1px solid var(--ink);padding:14px 22px;background:#fff;color:var(--ink)}
    .btn:hover{border-color:var(--accent)}
    .btn-dark{background:var(--ink);color:#fff;border-color:var(--ink)}
    .btn-dark:hover{background:var(--accent);border-color:var(--accent);color:#fff}
    .btn-wa{background:#25d366;border-color:#25d366;color:#0b2e13}
    .btn-wa:hover{filter:brightness(1.05);color:#0b2e13}
    .size-pill{min-height:40px;padding:0 18px;border-radius:999px;font:500 13px Inter,sans-serif;
      letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--ink);background:#fff;color:var(--ink);
      display:inline-flex;align-items:center}
    .size-pill.on{background:var(--ink);color:#fff}
    .card{display:flex;flex-direction:column;background:#fff;border-radius:14px;overflow:hidden;
      border:1px solid var(--line);transition:transform .25s,box-shadow .25s,border-color .25s}
    .card:hover{transform:translateY(-6px);border-color:#cdbfb2;box-shadow:0 22px 34px -18px rgba(26,20,22,.3)}
    .card .ph{position:relative;aspect-ratio:3/4;background:var(--panel);overflow:hidden}
    .card .ph img{width:100%;height:100%;object-fit:cover}
    .badge{position:absolute;top:12px;left:12px;font-size:11px;letter-spacing:.12em;text-transform:uppercase;
      background:rgba(255,255,255,.9);padding:5px 9px;border-radius:999px;color:var(--ink)}
    .badge.sold{background:var(--ink);color:#fff}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:30px 22px}
    .panel{background:var(--panel);border-radius:14px}
    input,select,textarea{font:400 15px Inter,sans-serif;color:var(--ink);background:#fff;
      border:1px solid var(--line);border-radius:10px;padding:12px 14px;width:100%}
    input:focus,select:focus,textarea:focus{outline:none;border-color:var(--accent);box-shadow:0 0 0 3px rgba(92,101,52,.15)}
    label.field{display:block;font-size:13px;color:var(--muted);margin-bottom:12px}
    label.field span{display:block;margin-bottom:6px}
    footer.site{border-top:1px solid var(--line);padding:56px 0;margin-top:8px}
    footer.site .cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:32px}
    footer.site h4{margin:0 0 10px;font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:600}
    footer.site p{margin:0;font-size:15px;line-height:1.6;color:var(--muted)}
    .muted{color:var(--muted)}
    .pricetag{font-variant-numeric:tabular-nums}

    /* Fitting room — the spinning hero */
    .fr{display:flex;flex-wrap:wrap;gap:36px;margin-top:24px;border-top:1px solid var(--line);padding-top:28px;align-items:center}
    .fr-stage{flex:999 1 520px;min-width:0;position:relative;height:clamp(380px,46vw,540px)}
    .fr-orbit{position:absolute;inset:0;animation:fr-spin 42s linear infinite}
    .fr-dress{position:absolute;width:88px;height:124px;margin:0;border:0;padding:0;background:none;cursor:pointer;
      border-radius:12px;overflow:hidden;box-shadow:0 12px 26px -16px rgba(43,39,36,.55);
      animation:fr-spin 42s linear infinite reverse}
    .fr-dress img{width:100%;height:100%;object-fit:cover;border-radius:12px;background:var(--panel)}
    .fr-dress.on{outline:3px solid var(--accent);outline-offset:2px}
    .fr-stage.paused .fr-orbit,.fr-stage.paused .fr-dress{animation-play-state:paused}
    @keyframes fr-spin{to{transform:rotate(360deg)}}
    .fr-pedestal{position:absolute;left:50%;top:84%;width:68%;height:48px;transform:translateX(-50%);
      border-radius:50%;background:radial-gradient(closest-side,#ddd2c5,rgba(241,235,228,0))}
    .fr-center{position:absolute;left:50%;top:50%;width:min(56%,248px);aspect-ratio:3/4;transform:translate(-50%,-50%);
      border-radius:16px;overflow:hidden;background:transparent;z-index:5}
    .fr-center img{width:100%;height:100%;object-fit:contain}
    .fr-panel{flex:1 1 280px;min-width:0;display:flex;flex-direction:column;gap:14px;padding-top:4px}
    .fr-round{width:48px;height:48px;flex:none;border-radius:50%;border:1px solid var(--ink);background:#fff;cursor:pointer;
      display:flex;align-items:center;justify-content:center;color:var(--ink)}
    .fr-round:hover{border-color:var(--accent);color:var(--accent)}
    .fr-upnext{display:flex;align-items:center;gap:14px;width:100%;padding:10px 0;border:0;border-bottom:1px solid var(--line);
      background:none;cursor:pointer;text-align:left;font:400 15px Inter,sans-serif;color:var(--ink)}
    .fr-upnext img{width:34px;height:46px;object-fit:cover;border-radius:6px;background:var(--panel)}
    @media (prefers-reduced-motion:reduce){.fr-orbit,.fr-dress{animation:none}}
  </style>
</head>
<body>
  <div class="announce">{{ brand.announcement }}</div>
  <header class="site">
    <a href="/shop" class="logo">{{ brand.name }} <span>{{ brand.suffix }}</span></a>
    <nav class="pills">
      <a href="/shop">The drop</a>
      <a href="/shop#how">How to order</a>
      <a href="/shop#policy">Delivery</a>
      <a href="/shop/cart" class="bag">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1 12H6L5 8z"/><path d="M9 8V7a3 3 0 0 1 6 0v1"/></svg>
        Bag{% if cartCount %} ({{ cartCount }}){% endif %}
      </a>
    </nav>
  </header>

  <main>{% block content %}{% endblock %}</main>

  <footer class="site" id="policy">
    <div class="wrap cols">
      <div>
        <div class="logo">{{ brand.name }} <span>{{ brand.suffix }}</span></div>
        <p style="margin-top:12px">{{ brand.tagline }}</p>
      </div>
      <div>
        <h4>Delivery</h4>
        <p>{{ brand.deliveryNote }}</p>
      </div>
      <div>
        <h4>Please note</h4>
        <p>{{ brand.policyNote }}</p>
      </div>
      <div>
        <h4>Talk to us</h4>
        <p style="line-height:1.9">
          <a href="https://wa.me/{{ brand.whatsapp }}">WhatsApp {{ brand.phoneDisplay }}</a><br>
          <a href="{{ brand.tiktokUrl }}">TikTok {{ brand.tiktok }}</a>
        </p>
      </div>
    </div>
  </footer>
</body>
</html>
