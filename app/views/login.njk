{% extends "layout.njk" %}
{% block title %}Login — WhatsApp Bot{% endblock %}
{% block content %}
<div class="max-w-sm mx-auto mt-12 bg-white rounded-xl shadow p-6">
  <h1 class="text-lg font-semibold mb-4">Admin login</h1>
  {% if error %}
  <p class="mb-3 text-sm text-red-600">{{ error }}</p>
  {% endif %}
  <form method="post" action="/admin/login" class="space-y-3">
    <input name="username" placeholder="Username" autocomplete="username"
           class="w-full border rounded-lg px-3 py-2" required>
    <input name="password" type="password" placeholder="Password" autocomplete="current-password"
           class="w-full border rounded-lg px-3 py-2" required>
    <button class="w-full bg-emerald-700 text-white rounded-lg py-2 font-medium">Log in</button>
  </form>
</div>
{% endblock %}
