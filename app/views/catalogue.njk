{% extends "layout.njk" %}
{% block title %}Dresses — Dress Nation Admin{% endblock %}
{% block content %}
<div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px;margin-bottom:20px">
  <div>
    <p class="e-eyebrow" style="margin:0 0 8px">Shop</p>
    <h1 class="e-h1" style="margin:0">Dresses</h1>
  </div>
  <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
    <form method="post" action="/admin/catalogue/scan"><button class="e-btn">Scan inbox</button></form>
    <form method="post" action="/admin/catalogue/publish-all"
          onsubmit="return confirm('Publish all reviewed drafts to WhatsApp Status and the shop?')">
      <button class="e-btn e-btn-dark">Publish all</button>
    </form>
  </div>
</div>

<form method="post" action="/admin/catalogue/upload" enctype="multipart/form-data"
      class="e-card" style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;margin-bottom:16px">
  <div style="flex:1 1 240px;min-width:0">
    <label style="font-size:14px;font-weight:500">Upload dress photos</label>
    <input type="file" name="photos" accept="image/*" multiple required style="margin-top:6px;display:block;width:100%;font-size:14px">
    <p class="e-muted" style="font-size:12px;margin:6px 0 0">Each photo is scanned (size &amp; price) and added as a draft. Star the ones you want spinning in the shop's fitting room.</p>
  </div>
  <button class="e-btn e-btn-olive">Upload &amp; scan</button>
</form>

{% if message %}<p class="e-tag" style="display:block;background:var(--panel);padding:12px 14px;border-radius:10px;font-size:14px;text-transform:none;letter-spacing:0;margin-bottom:16px">{{ message }}</p>{% endif %}
{% if scan %}
<div style="background:var(--panel);border-radius:10px;padding:12px 14px;font-size:14px;margin-bottom:16px">
  Imported {{ scan.imported.length }}, skipped {{ scan.skipped }} already-seen file(s).
  {% if scan.failed.length %}<ul style="color:#7a1f2b;margin:6px 0 0">{% for f in scan.failed %}<li>{{ f.file }}: {{ f.error }}</li>{% endfor %}</ul>{% endif %}
</div>
{% endif %}

<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px">
  {% for f in [
    { key: 'all', label: 'All' },
    { key: 'needs_review', label: 'Needs review' },
    { key: 'draft', label: 'Draft' },
    { key: 'published', label: 'Published' },
    { key: 'sold', label: 'Sold' }
  ] %}
  <a href="/admin/catalogue?filter={{ f.key }}" class="e-pill {{ 'on' if filter == f.key }}">
    {{ f.label }}{% if counts[f.key] %} ({{ counts[f.key] }}){% endif %}
  </a>
  {% endfor %}
</div>

<div style="display:flex;flex-direction:column;gap:14px">
  {% for p in products %}
  <div class="e-card" style="display:flex;gap:16px;padding:16px">
    <a href="/shop/img/{{ p.id }}" target="_blank" title="View full photo" style="flex:none">
      <img src="/shop/img/{{ p.id }}" style="width:96px;height:128px;object-fit:cover;border-radius:10px;background:var(--panel)" alt="">
    </a>
    <div style="flex:1 1 auto;min-width:0;display:flex;flex-direction:column;gap:12px">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span style="font-weight:500">#{{ p.id }}</span>
        <span class="e-tag" style="
          {% if p.status == 'published' %}background:var(--accent);color:#fff
          {% elif p.status == 'sold' %}background:var(--ink);color:#fff
          {% else %}background:var(--panel);color:var(--ink){% endif %}">{{ p.status }}</span>
        {% if p.needs_review %}<span class="e-tag" style="background:#f3dcd3;color:#7a1f2b">needs review</span>{% endif %}
        {% if p.featured %}<span class="e-tag" style="background:#eef0e4;color:var(--accent)">★ fitting room</span>{% endif %}
        {% if p.ocr_source %}<span class="e-muted" style="font-size:12px">ocr: {{ p.ocr_source }}</span>{% endif %}
      </div>
      <form method="post" action="/admin/catalogue/{{ p.id }}?filter={{ filter }}" style="display:flex;gap:8px;flex-wrap:wrap">
        <input name="title" value="{{ p.title or '' }}" placeholder="Dress #{{ p.id }}" class="e-input" style="width:150px">
        <input name="size" value="{{ p.size or '' }}" placeholder="e.g. 14 or 8/10" class="e-input" style="width:120px">
        <input name="price" value="{{ p.price_ksh or 1000 }}" placeholder="Ksh" class="e-input" style="width:96px">
        <button class="e-btn">Save</button>
      </form>
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <form method="post" action="/admin/catalogue/{{ p.id }}/featured?filter={{ filter }}">
          <input type="hidden" name="featured" value="{{ 'off' if p.featured else 'on' }}">
          <button class="e-pill {{ 'on' if p.featured }}" style="{% if p.featured %}background:var(--accent);border-color:var(--accent){% endif %}">
            {{ '★ In fitting room' if p.featured else '☆ Add to fitting room' }}
          </button>
        </form>
        <a href="/admin/catalogue/{{ p.id }}/edit" class="e-btn">Edit details{% if p.ai_ingested_at %} ✓AI{% endif %}</a>
        <form method="post" action="/admin/catalogue/{{ p.id }}/ingest">
          <button class="e-btn e-btn-olive">✨ Enrich with AI</button>
        </form>
        {% if p.status == 'draft' %}
        <form method="post" action="/admin/catalogue/{{ p.id }}/publish"><button class="e-btn e-btn-dark">Publish (status + shop)</button></form>
        {% elif p.status == 'published' %}
        <form method="post" action="/admin/catalogue/{{ p.id }}/publish"><button class="e-btn">Repost status</button></form>
        <form method="post" action="/admin/catalogue/{{ p.id }}/status/sold"><button class="e-btn">Mark sold</button></form>
        {% elif p.status == 'sold' %}
        <form method="post" action="/admin/catalogue/{{ p.id }}/status/published"><button class="e-btn">Back to shop</button></form>
        {% endif %}
        <form method="post" action="/admin/catalogue/{{ p.id }}/status/archived" onsubmit="return confirm('Archive this product?')">
          <button class="e-btn" style="color:#7a1f2b;border-color:#d8b4ab">Archive</button>
        </form>
      </div>
    </div>
  </div>
  {% else %}
  <p class="e-muted e-card" style="font-size:14px">
    {% if filter == 'all' %}Nothing yet — upload photos above, or drop them in the inbox folder and hit <strong>Scan inbox</strong>.
    {% else %}No dresses in “{{ filter }}”.{% endif %}
  </p>
  {% endfor %}
</div>
{% endblock %}
