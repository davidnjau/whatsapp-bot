{% extends "layout.njk" %}
{% block title %}Catalogue — WhatsApp Bot{% endblock %}
{% block content %}
<div class="flex items-center justify-between">
  <h1 class="text-lg font-semibold">Catalogue</h1>
  <div class="flex gap-2 items-center">
    <a href="/shop" target="_blank" class="text-sm text-emerald-700 underline">View shop →</a>
    <form method="post" action="/admin/catalogue/scan">
      <button class="text-sm bg-emerald-700 text-white rounded-lg px-3 py-2">Scan inbox</button>
    </form>
  </div>
</div>
{% if message %}<p class="text-sm bg-emerald-50 text-emerald-800 rounded-lg p-2">{{ message }}</p>{% endif %}
{% if scan %}
<div class="text-sm bg-emerald-50 text-emerald-900 rounded-lg p-3">
  Imported {{ scan.imported.length }}, skipped {{ scan.skipped }} already-seen file(s).
  {% if scan.failed.length %}
  <ul class="text-red-700 mt-1">
    {% for f in scan.failed %}<li>{{ f.file }}: {{ f.error }}</li>{% endfor %}
  </ul>
  {% endif %}
</div>
{% endif %}

<div class="space-y-3">
  {% for p in products %}
  <div class="bg-white rounded-xl shadow p-3 flex gap-3">
    <img src="/shop/img/{{ p.id }}" class="w-24 h-24 object-cover rounded-lg" alt="">
    <div class="flex-1 space-y-2">
      <div class="flex items-center gap-2 text-sm flex-wrap">
        <span class="font-medium">#{{ p.id }}</span>
        <span class="px-2 py-0.5 rounded-full text-xs
          {% if p.status == 'published' %}bg-emerald-100 text-emerald-800
          {% elif p.status == 'sold' %}bg-gray-200 text-gray-600
          {% else %}bg-amber-100 text-amber-800{% endif %}">{{ p.status }}</span>
        {% if p.needs_review %}<span class="px-2 py-0.5 rounded-full text-xs bg-red-100 text-red-800">needs review</span>{% endif %}
        {% if p.ocr_source %}<span class="text-xs text-gray-400">ocr: {{ p.ocr_source }}</span>{% endif %}
      </div>
      <form method="post" action="/admin/catalogue/{{ p.id }}" class="flex gap-2 flex-wrap text-sm">
        <input name="title" value="{{ p.title or '' }}" placeholder="Dress #{{ p.id }}" class="border rounded-lg px-2 py-1 w-36">
        <input name="size" value="{{ p.size or '' }}" placeholder="size" class="border rounded-lg px-2 py-1 w-20">
        <input name="price" value="{{ p.price_ksh or '' }}" placeholder="Ksh" class="border rounded-lg px-2 py-1 w-24">
        <button class="border rounded-lg px-3 py-1 hover:bg-gray-50">Save</button>
      </form>
      <div class="flex gap-2 text-xs">
        {% if p.status == 'draft' %}
        <form method="post" action="/admin/catalogue/{{ p.id }}/publish">
          <button class="bg-emerald-700 text-white rounded-lg px-3 py-1">Publish (status + shop)</button>
        </form>
        {% elif p.status == 'published' %}
        <form method="post" action="/admin/catalogue/{{ p.id }}/publish">
          <button class="border rounded-lg px-3 py-1 hover:bg-gray-50">Repost status</button>
        </form>
        <form method="post" action="/admin/catalogue/{{ p.id }}/status/sold">
          <button class="border rounded-lg px-3 py-1 hover:bg-gray-50">Mark sold</button>
        </form>
        {% elif p.status == 'sold' %}
        <form method="post" action="/admin/catalogue/{{ p.id }}/status/published">
          <button class="border rounded-lg px-3 py-1 hover:bg-gray-50">Back to shop</button>
        </form>
        {% endif %}
        <form method="post" action="/admin/catalogue/{{ p.id }}/status/archived"
              onsubmit="return confirm('Archive this product?')">
          <button class="border rounded-lg px-3 py-1 text-red-600 hover:bg-red-50">Archive</button>
        </form>
      </div>
    </div>
  </div>
  {% else %}
  <p class="text-sm text-gray-500 bg-white rounded-xl shadow p-4">
    Nothing yet — drop photos in the inbox folder and hit <strong>Scan inbox</strong>.
  </p>
  {% endfor %}
</div>
{% endblock %}
