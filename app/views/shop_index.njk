{% extends "shop_layout.njk" %}
{% block content %}

<section class="wrap" style="padding:24px 24px 56px" id="top">
  <p class="eyebrow">{{ brand.heroEyebrow }}</p>
  <h1 style="margin-top:12px;font-size:clamp(40px,6vw,82px);line-height:1.02">
    {{ brand.heroLead }} <span style="color:var(--accent)">{{ brand.heroAccent }}</span>
  </h1>
  {% if fittingRoom.length %}
  <div class="fr">
    <div class="fr-stage" id="frStage" aria-label="The fitting room">
      <div class="fr-pedestal"></div>
      <div class="fr-orbit" id="frOrbit">
        {% for p in fittingRoom %}
        <button type="button" class="fr-dress" data-i="{{ loop.index0 }}"
                data-id="{{ p.id }}" data-name="{{ p.name }}" data-size="{{ p.size or '' }}" data-price="{{ p.priceFmt }}"
                aria-label="Try on {{ p.name }}">
          <img src="/shop/img/{{ p.id }}" alt="{{ p.name }}" loading="lazy">
        </button>
        {% endfor %}
      </div>
      <a class="fr-center" id="frCenter" href="/shop/p/{{ fittingRoom[0].id }}" aria-label="View the dress now on show">
        <img id="frCenterImg" src="/shop/img/{{ fittingRoom[0].id }}" alt="{{ fittingRoom[0].name }}">
      </a>
    </div>

    <div class="fr-panel">
      <div style="display:flex;justify-content:space-between;align-items:center" class="eyebrow">
        <span>Now wearing</span><span id="frCount">1 / {{ fittingRoom.length }}</span>
      </div>
      <h2 id="frName" style="font-size:30px;line-height:1.14">{{ fittingRoom[0].name }}</h2>
      <p class="muted" style="margin:0;font-size:15px;line-height:1.6">{{ brand.tagline }}</p>
      <div style="display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:14px 0">
        <span id="frSize">{% if fittingRoom[0].size %}Size {{ fittingRoom[0].size }}{% else %}One size{% endif %}</span>
        <span class="pricetag" id="frPrice" style="font-size:24px">{{ fittingRoom[0].priceFmt }}</span>
      </div>
      <div style="display:flex;gap:10px;align-items:center">
        <button type="button" class="fr-round" id="frPrev" aria-label="Previous dress">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M15 5l-7 7 7 7"/></svg>
        </button>
        <form method="post" action="/shop/cart/add" style="flex:1 1 auto">
          <input type="hidden" name="productId" id="frAddId" value="{{ fittingRoom[0].id }}">
          <button class="btn btn-dark" style="width:100%;padding:14px">Add to bag</button>
        </form>
        <button type="button" class="fr-round" id="frNext" aria-label="Next dress">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
      <div>
        <p class="eyebrow" style="margin-bottom:4px">Up next</p>
        <div id="frUpNext"></div>
      </div>
    </div>
  </div>

  <script>
  (function () {
    var stage = document.getElementById('frStage');
    if (!stage) return;
    var orbit = document.getElementById('frOrbit');
    var dresses = Array.prototype.slice.call(orbit.querySelectorAll('.fr-dress'));
    var n = dresses.length, active = 0, timer;
    var centerImg = document.getElementById('frCenterImg');
    var centerLink = document.getElementById('frCenter');
    var upNext = document.getElementById('frUpNext');

    function layout() {
      var w = stage.clientWidth, h = stage.clientHeight;
      var r = Math.min(w, h) / 2 - 56;
      dresses.forEach(function (d, i) {
        var a = (i / n) * 2 * Math.PI - Math.PI / 2;
        d.style.left = (w / 2 + r * Math.cos(a) - 44) + 'px';
        d.style.top = (h / 2 + r * Math.sin(a) - 62) + 'px';
      });
    }

    function render() {
      var d = dresses[active];
      var id = d.dataset.id;
      centerImg.src = '/shop/img/' + id;
      centerImg.alt = d.dataset.name;
      centerLink.href = '/shop/p/' + id;
      document.getElementById('frName').textContent = d.dataset.name;
      document.getElementById('frSize').textContent = d.dataset.size ? 'Size ' + d.dataset.size : 'One size';
      document.getElementById('frPrice').textContent = d.dataset.price;
      document.getElementById('frAddId').value = id;
      document.getElementById('frCount').textContent = (active + 1) + ' / ' + n;
      dresses.forEach(function (x, i) { x.classList.toggle('on', i === active); });
      upNext.innerHTML = '';
      for (var k = 1; k <= Math.min(2, n - 1); k++) {
        var nd = dresses[(active + k) % n];
        var b = document.createElement('button');
        b.type = 'button'; b.className = 'fr-upnext'; b.dataset.go = (active + k) % n;
        b.innerHTML = '<img src="/shop/img/' + nd.dataset.id + '" alt=""><span style="flex-grow:1">' +
          nd.dataset.name + '</span><span style="font-size:13px;color:var(--muted)">' +
          (nd.dataset.size ? 'Size ' + nd.dataset.size : '') + '</span>';
        upNext.appendChild(b);
      }
    }

    function go(i) { active = (i + n) % n; render(); }

    dresses.forEach(function (d) { d.addEventListener('click', function () { go(Number(d.dataset.i)); }); });
    document.getElementById('frPrev').addEventListener('click', function () { go(active - 1); });
    document.getElementById('frNext').addEventListener('click', function () { go(active + 1); });
    upNext.addEventListener('click', function (e) {
      var b = e.target.closest('[data-go]'); if (b) go(Number(b.dataset.go));
    });

    function start() { stop(); if (n > 1) timer = setInterval(function () { go(active + 1); }, 4000); }
    function stop() { if (timer) clearInterval(timer); }
    stage.addEventListener('mouseenter', function () { stage.classList.add('paused'); stop(); });
    stage.addEventListener('mouseleave', function () { stage.classList.remove('paused'); start(); });

    layout(); render(); start();
    window.addEventListener('resize', layout);
  })();
  </script>
  {% endif %}
</section>

<section style="border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="wrap" style="padding:64px 24px">
    <p style="margin:0;max-width:940px;font-size:clamp(24px,3.2vw,42px);line-height:1.25">
      {{ brand.manifesto }} <span style="color:var(--accent)">{{ brand.manifestoAccent }}</span>
    </p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:32px;margin-top:48px">
      {% for s in brand.stats %}
      <div>
        <div style="font-size:54px;line-height:1">{{ s.n }}</div>
        <p class="eyebrow" style="margin-top:10px">{{ s.l }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section class="wrap" style="padding:64px 24px" id="shop">
  <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:20px;margin-bottom:28px">
    <div>
      <p class="eyebrow">{{ products.length }} piece{{ 's' if products.length != 1 }}{% if activeSize != 'All' %} · size {{ activeSize }}{% endif %}</p>
      <h2 style="margin-top:8px;font-size:clamp(34px,5vw,52px)">This week's <span style="color:var(--accent)">drop</span></h2>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:8px">
      {% for s in sizes %}
      <a href="/shop{% if s != 'All' %}?size={{ s }}{% endif %}#shop" class="size-pill {{ 'on' if s == activeSize }}">
        {{ 'All sizes' if s == 'All' else 'Size ' + s }}
      </a>
      {% endfor %}
    </div>
  </div>

  {% if products.length %}
  <div class="grid">
    {% for p in products %}
    <article class="card">
      <a href="/shop/p/{{ p.id }}" class="ph">
        <img src="/shop/img/{{ p.id }}" alt="{{ p.name }}" loading="lazy">
        {% if p.size %}<span class="badge">Size {{ p.size }}</span>{% endif %}
      </a>
      <div style="padding:16px;display:flex;flex-direction:column;gap:12px;flex-grow:1">
        <div style="display:flex;justify-content:space-between;gap:12px">
          <div style="min-width:0">
            <h3 style="font-size:16px;line-height:1.3">{{ p.name }}</h3>
            <p class="muted pricetag" style="margin:4px 0 0;font-size:14px">{{ p.priceFmt }}</p>
          </div>
        </div>
        <form method="post" action="/shop/cart/add" style="margin-top:auto">
          <input type="hidden" name="productId" value="{{ p.id }}">
          <button class="btn btn-dark" style="width:100%">Add to bag</button>
        </form>
      </div>
    </article>
    {% endfor %}
  </div>
  {% else %}
  <div class="panel" style="padding:40px;text-align:center" class="muted">
    <p class="muted" style="margin:0">No dresses in this size right now. <a href="/shop#shop" style="color:var(--accent)">See all sizes →</a></p>
  </div>
  {% endif %}
</section>

<section id="how" style="border-top:1px solid var(--line)">
  <div class="wrap" style="padding:64px 24px;display:flex;flex-wrap:wrap;gap:48px">
    <div style="flex:999 1 420px;min-width:0">
      <h2 style="margin-bottom:28px;font-size:clamp(34px,5vw,52px)">From your bag <span style="color:var(--accent)">to your door.</span></h2>
      {% for step in [
        {t:'Pick your pieces', d:'Browse the drop, filter by your size, and add dresses to your bag. Each one is a single piece.'},
        {t:'Check out', d:'Give your town and a Pickup Mtaani option. We confirm each piece is still available and the delivery fee.'},
        {t:'Pay and receive', d:'Pay by M-Pesa and we dispatch countrywide, then send you a tracking code to follow your parcel.'}
      ] %}
      <div style="display:flex;gap:24px;padding:22px 0;border-top:1px solid var(--line){{ ';border-bottom:1px solid var(--line)' if loop.last }}">
        <div style="flex:none;width:34px;height:34px;border-radius:50%;border:1px solid var(--accent);color:var(--accent);display:flex;align-items:center;justify-content:center;font-weight:600">{{ loop.index }}</div>
        <div>
          <h3 style="font-size:17px;font-weight:600;margin-bottom:6px">{{ step.t }}</h3>
          <p class="muted" style="margin:0;font-size:15px;line-height:1.55">{{ step.d }}</p>
        </div>
      </div>
      {% endfor %}
    </div>
    {% if featured.length %}
    <a href="/shop/p/{{ featured[0].id }}" style="flex:1 1 300px;min-height:360px;border-radius:14px;overflow:hidden;background:var(--panel)">
      <img src="/shop/img/{{ featured[0].id }}" alt="" style="width:100%;height:100%;object-fit:cover">
    </a>
    {% endif %}
  </div>
</section>

{% endblock %}
