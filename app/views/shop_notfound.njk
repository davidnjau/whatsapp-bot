{% extends "shop_layout.njk" %}
{% block title %}Not available — {{ brand.name }} {{ brand.suffix }}{% endblock %}
{% block content %}
<section class="wrap" style="padding:72px 24px;text-align:center;max-width:560px">
  <p class="eyebrow">Each piece is unique</p>
  <h1 style="margin-top:12px;font-size:clamp(32px,5vw,48px)">This dress has <span style="color:var(--accent)">left the rail.</span></h1>
  <p class="muted" style="margin-top:16px;font-size:16px;line-height:1.6">
    It may have sold or isn't listed yet. There's only ever one of each — but the drop is full of pieces waiting for you.
  </p>
  <a href="/shop#shop" class="btn btn-dark" style="margin-top:24px">See available dresses</a>
</section>
{% endblock %}
