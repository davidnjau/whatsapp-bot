{% extends "shop_layout.njk" %}
{% block title %}Not available — Dress Nation ~254{% endblock %}
{% block content %}
<div class="bg-white rounded-2xl shadow p-8 text-center space-y-3">
  <p class="text-4xl">👗</p>
  <h1 class="text-lg font-bold text-rose-900">This dress isn't available</h1>
  <p class="text-sm text-gray-600">
    It may have sold (each piece is unique!) or isn't listed yet.
    Browse the other dresses — something will catch your eye 💕
  </p>
  <a href="/shop" class="inline-block bg-rose-600 text-white rounded-xl px-6 py-3 font-medium hover:bg-rose-700">
    See available dresses
  </a>
</div>
{% endblock %}
